# ==========================================
# STAGE 1: Base con PNPM
# ==========================================
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate

# ==========================================
# STAGE 2: Dependencias y Build (Compilación)
# ==========================================
FROM base AS builder
WORKDIR /app

# Copiamos manifiestos de dependencias del monorepo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Instalamos TODAS las dependencias para compilar con Nx
# --frozen-lockfile garantiza reproducibilidad; omitimos scripts como husky si existieran
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copiamos el código fuente completo del monorepo (respetando .dockerignore)
COPY . .

# Argumento para el nombre de la app (por defecto kardusbag)
ARG APP_NAME=kardusbag

# Compilamos la aplicación usando Nx (NxAppWebpackPlugin genera dist/apps/${APP_NAME} con su package.json y pnpm-lock.yaml)
RUN pnpm exec nx build ${APP_NAME} --prod

# Instalamos únicamente las dependencias de producción en el directorio compilado
WORKDIR /app/dist/apps/${APP_NAME}
RUN pnpm install --prod --frozen-lockfile

# ==========================================
# STAGE 3: Runner de Producción (Ultra ligero)
# ==========================================
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ARG APP_NAME=kardusbag

# Copiamos la compilación de la app junto a sus dependencias de producción
COPY --from=builder /app/dist/apps/${APP_NAME} ./

EXPOSE 3000

# Iniciamos la API con Node puro (sin depender de pnpm en runtime)
CMD ["node", "main.js"]