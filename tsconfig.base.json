{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@kardusbag/core": ["./libs/core/src/index.ts"],
      "@kardusbag/database": ["./libs/database/src/index.ts"],
      "@kardusbag/bag": ["./libs/domains/bag/src/index.ts"],
      "@kardusbag/promotions": ["./libs/domains/promotions/src/index.ts"],
      "@kardusbag/shared": ["./libs/shared/src/index.ts"],
      "@kardusbag/collections": ["./libs/domains/collections/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
